# ============================================
# ServiceKU - Staging Environment
# ============================================
# Copy ke .env untuk staging:
#   cp .env.staging .env
#   php artisan key:generate
# ============================================

APP_NAME=ServiceKU
APP_ENV=staging
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# Generate ulang untuk staging: php artisan key:generate
APP_KEY=

APP_URL=http://staging.serviceku.my.id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ========== DATABASE ==========
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serviceku_staging
DB_USERNAME=serviceku
DB_PASSWORD=serviceku_staging_pass

# ========== SESSION (Staging) ==========
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ========== CACHE & QUEUE ==========
CACHE_STORE=file
QUEUE_CONNECTION=database

# ========== MAIL (SMTP) ==========
MAIL_MAILER=log
MAIL_FROM_ADDRESS=staging@serviceku.my.id
MAIL_FROM_NAME="${APP_NAME}"

# ========== CLOUDFLARE TUNNEL ==========
TUNNEL_TOKEN=
TUNNEL_DOMAIN=staging.serviceku.my.id

# ========== TENANCY ==========
CENTRAL_DOMAIN=serviceku.my.id
ADMIN_DOMAIN=admin.serviceku.my.id
MAIL_DOMAIN=serviceku.my.id

# ========== API KEYS (isi dengan nilai staging, bukan production) ==========
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
